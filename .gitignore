/target/

# Release package — built artefacts, never source.
/release/
# Assembled MacNCL.app bundle (run-gui.sh); rebuilt on demand.
/build/

# Scratch / temp directories.
/tmp/

# SBCL (downloaded reference implementation, used only for A/B benchmarking).
/sbcl/

# Local debug / phase-dump artifacts produced by the driver and tests.
# Useful while iterating, never committed.
*.log
*.ll
/out.log
/out.txt

# Captured stdout/stderr from test runs.
ncl-stdout*.txt
ncl-stderr*.txt

# Loader artifact cache (non-canonical, see MANIFESTO.md). Source is
# canonical; the cache can be deleted at any time without loss.
/.ncl-cache/

# macOS
.DS_Store

# Windows-only material — removed in the Mac fork; keep it out.
/tools/
/scripts/
/packs/
*.bat
*.ps1
/Lisp/Library/win32*.lisp

# Binaries, libraries, and archives — never source.
*.exe
*.dll
*.dylib
*.so
*.a
*.lib
*.o
*.obj
*.pdb
*.pack
*.zip
*.tar
*.tgz
*.7z
*.dmg

# GUI debug frame dumps (NCL_IGUI_DUMP=frame.ppm).
*.ppm

# Editor scratch.
/scratchpad

# installer build output
/dist/
